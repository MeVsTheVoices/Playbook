# Copy to .env and uncomment what you need; Docker Compose reads it automatically.
# Every value is optional: the defaults below are what compose.yaml uses when unset.

# 🧩 Optional modules. Add compose.kubernetes.yaml to enable the cluster page, Helm and the Tailscale operator.
# COMPOSE_FILE=compose.yaml:compose.kubernetes.yaml
# PLAYBOOK_MODULES=kubernetes

# 📞 Node callback listener (LAN-facing, answers node endpoints only).
# CALLBACK_PORT=8088
# Address nodes use to reach this machine, when it differs from what the browser sees.
# CALLBACK_PUBLIC_URL=http://192.168.1.10:8088

# 🔒 Dashboard listener. Binds to this machine only unless opened to the LAN.
# CALLBACK_ADMIN_BIND=127.0.0.1
# CALLBACK_ADMIN_PORT=8091
# Extra host names the dashboard answers to (comma separated), e.g. a tailnet name.
# CALLBACK_ADMIN_HOSTS=playbook.tail00c2ce.ts.net

# ☸️ Join address written into new K3s nodes. Any K3s server works; a VIP or load balancer in front
# of every server removes the single point of failure.
# K3S_API_ENDPOINT=https://k3s.example.lan:6443

# 💾 Host SD/USB flasher (scripts/run_sd_flasher.sh). Set to an empty value to disable.
# SD_FLASHER_URL=http://host.docker.internal:8089
