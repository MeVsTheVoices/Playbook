# Managed by the playbook-server profile; playbook-server-activate reads these keys.
PLAYBOOK_REPO_URL={{ server_repo_url }}
PLAYBOOK_REF={{ server_ref }}
PLAYBOOK_PORT={{ server_port }}
PLAYBOOK_INSTALL_FLASHER={{ 'true' if server_install_flasher | string | lower == 'true' else 'false' }}
PLAYBOOK_DIR={{ server_dir }}
